{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/app.py" },
    { "source": "/pdf/(.*)", "destination": "/app.py" },
    { "source": "/files/(.*)", "destination": "/app.py" }
  ]
}
